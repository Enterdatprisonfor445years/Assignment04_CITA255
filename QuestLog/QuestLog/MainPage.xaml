<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestLog.MainPage"
             Title="Quest Log">

    <Grid RowDefinitions="Auto,Auto,*,Auto, Auto, Auto"
          Padding="24"
          RowSpacing="14">

        <Label Grid.Row="0"
               Text="Quest Log"
               FontSize="30"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               x:Name="CountLabel"
               Text="0 quests"
               FontSize="14"
               TextColor="Gray" />

        <Border Grid.Row="2" Stroke="LightGray" StrokeThickness="1" Padding="4">

            <CollectionView x:Name="QuestView" ItemsSource="{Binding Quests}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto" Padding="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Giver}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                       Text="{Binding Reward, StringFormat='{0} XP'}" 
                       VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No quests yet." 
               FontSize="16" TextColor="Gray" 
               HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <VerticalStackLayout Grid.Row="3" Margin="0,10" Spacing="8">
            <Entry x:Name="TitleEntry" Placeholder="Enter the Quest Name" TextColor="White" PlaceholderColor="Gray" />
            <Entry x:Name="GiverEntry" Placeholder="Enter the Quest Giver" TextColor="White" PlaceholderColor="Gray" />
            <Entry x:Name="RewardEntry" Placeholder="Enter the Quest Reward" Keyboard="Numeric" TextColor="White" PlaceholderColor="Gray" />
        </VerticalStackLayout>

        <Button Grid.Row="3"
                Text="Accept a quest"
                Clicked="OnAddClicked" />
        <Button Grid.Row="4"
                Text="Turn the quest in."
                Clicked="OnTurnInQuestClicked" />
    </Grid>
</ContentPage>
