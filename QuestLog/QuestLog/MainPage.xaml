<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestLog.MainPage"
             Title="Quest Log">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
      Padding="24"
      RowSpacing="14">

        <!-- Title of the application -->
        <Label Grid.Row="0"
           Text="Quest Log"
           FontSize="30"
           FontAttributes="Bold" />

        <!-- Total active quest tracking counter -->
        <Label Grid.Row="1"
           x:Name="CountLabel"
           Text="0 quests"
           FontSize="14"
           TextColor="Gray" />

        <Border Grid.Row="2" Stroke="LightGray" StrokeThickness="1" Padding="4">
            <CollectionView x:Name="QuestView" ItemsSource="{Binding Quests}" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto" Padding="12,10" RowSpacing="0">

                            <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Giver}" FontAttributes="Bold" FontSize="16" TextColor="White" />
                                <Label Text=":" FontAttributes="Bold" FontSize="16" TextColor="White" />
                                <Label Text="{Binding Title}" FontSize="16" TextColor="LightGray" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Reward}" FontAttributes="Bold" FontSize="16" TextColor="#A855F7" />
                                <Label Text="XP" FontSize="14" TextColor="Gray" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <VerticalStackLayout Grid.Row="3" Margin="0,10" Spacing="8">
            <Entry x:Name="TitleField" 
               Placeholder="Enter the Quest Name"
               PlaceholderColor="Gray"
               TextColor="White"
               HeightRequest="44" />

            <Entry x:Name="GiverField" 
               Placeholder="Enter the Quest Giver"
               PlaceholderColor="Gray"
               TextColor="White"
               HeightRequest="44" />

            <Entry x:Name="RewardField" 
               Placeholder="Enter the Quest Reward (XP)"
               PlaceholderColor="Gray"
               TextColor="White"
               Keyboard="Numeric"
               HeightRequest="44" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="4" Spacing="8">
            <Button Text="Accept a quest" Clicked="OnAddClicked" />
            <Button Text="Turn the quest in" Clicked="OnTurnInQuestClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
